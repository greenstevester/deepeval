# DeepEval Local LLM Configuration
# Copy this file to .env and customize as needed

# Ollama Configuration
# For local development (Ollama running on host machine):
#   OLLAMA_BASE_URL=http://localhost:11434
# For Docker Compose (automatically set):
#   OLLAMA_BASE_URL=http://ollama-cpu:11434
# For remote Ollama server:
#   OLLAMA_BASE_URL=http://your-server:11434
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for evaluations
# Popular options: llama3.2, qwen2.5-coder:3b, mistral, codellama
OLLAMA_MODEL=llama3.2

# Host port for Ollama (only used in Docker Compose)
OLLAMA_HOST_PORT=11434

# DeepEval Configuration
DEEPEVAL_TELEMETRY_OPT_OUT=true

# =========================
# Local LLM (Docker/External)
# =========================
# For local development (Ollama running on host machine):
#   OLLAMA_BASE_URL=http://localhost:11434
# For Docker Compose:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
# For remote Ollama server:
#   OLLAMA_BASE_URL=http://your-server:11434
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for evaluations
# Popular options: llama3.2, qwen2.5-coder:7b, mistral, codellama
OLLAMA_MODEL=qwen2.5-coder:7b
